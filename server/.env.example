# Server Configuration
NODE_ENV=production
PORT=5000
# Production Frontend Origin (Cloudflare Workers/Pages URL) - NO trailing slash
CLIENT_URL=https://imovie-skillwallet.jaivish546.workers.dev
# Optional additional CORS origins (comma-separated, NO trailing slashes)
CORS_ORIGINS=https://imovie-skillwallet.jaivish546.workers.dev

# Database Connection (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/imovies?retryWrites=true&w=majority

# Authentication & Security (generate 32+ character random string for production)
JWT_ACCESS_SECRET=your_super_secure_jwt_access_secret_key_minimum_32_chars_long
JWT_ACCESS_EXPIRES_IN=2h
COOKIE_SECRET=your_super_secure_cookie_signer_secret_key_2026

# Payment Configuration
# Set PAYMENTS_ENABLED=false to run in safe payment-disabled production mode (recommended for demo deployments without real gateway keys)
PAYMENTS_ENABLED=false
# If PAYMENTS_ENABLED=true in production, PAYMENT_PROVIDER must be 'razorpay' or 'stripe' with real credentials
PAYMENT_PROVIDER=disabled
PAYMENT_TEST_MODE=true

# Razorpay Sandbox (Optional - required only if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Stripe Sandbox (Optional - required only if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Admin Initial Seed Credentials (for npm run seed:admin)
ADMIN_SEED_NAME="Cinema SuperAdmin"
ADMIN_SEED_EMAIL=vishwakarmanayan66@gmail.com
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_PHONE=+919876543210

# Logging & Storage
LOG_LEVEL=info
UPLOAD_DIR=uploads

# Email Service Provider: 'brevo' (HTTPS API, recommended for Render/cloud) | 'smtp' (traditional SMTP)
EMAIL_PROVIDER=brevo
# Brevo (formerly Sendinblue) HTTPS API Key - generate from Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_v3_api_key_here
EMAIL_FROM="IMovies Cinema <your_verified_sender@example.com>"
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# Optional SMTP Settings (fallback for local development or traditional SMTP servers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_google_app_password


